# Discord Bot Configuration
BOT_TOKEN=<BOTTOKEN>
CHANNEL_COMMAND_ID=<COMMAND CHANNEL ID>
ADMIN_USER_ID=<ADMIN USER ID>

# API Keys
GEMINI_API_KEY=<GEMINI API TOKEN>
TMDB_API_KEY=<TMDB API KEY>

# Metadata Service (OPTIONAL)
# If not set or empty, bot uses TMDB directly for posters
# Set this to use aiometadata service with RPDB for enhanced poster quality
# Use publicly accessible URL for poster fetching (required for Discord to display images)
# Examples:
#   - External domain: https://AIOMetadata
#   - Host port: http://your-server-ip:3232
#   - Docker service: http://metadata:1337
# METADATA_URL=https://AIOmetadata instance

# RPDB (Rating Poster Database) Configuration
# Poster database key for enhanced poster quality
# Default: t0-free-rpdb (free tier)
# Premium users can use their own key for higher quality/more posters
RPDB_KEY=t0-free-rpdb

# Language Configuration
# Available: ENGLISH, DUTCH
BOT_LANG=ENGLISH

# Docker Container Monitoring
# Comma-separated list of container names to monitor
# The /status command checks if these containers are running
MONITORED_CONTAINERS=container1,container2,container3....

# Security Configuration
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret! Anyone with this key can decrypt stored auth keys
ENCRYPTION_KEY=<GENERATE_WITH_COMMAND_ABOVE>
