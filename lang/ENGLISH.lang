LOADING_HELP_COG=  Loading help cog...
COG_LOADED=  ✅ {cog} cog loaded
ALL_COGS_LOADED=✅ All cogs loaded successfully
FAILED_LOAD_COGS=❌ Failed to load cogs: {error}

# Bot ready messages
BOT_READY=✅ Bot is READY and CONNECTED!
LOGGED_IN_AS=   Logged in as: {name}
BOT_ID=   Bot ID: {id}
CONNECTED_TO_SERVERS=   Connected to {count} server(s)
SHUTTING_DOWN=🔄 Shutting down...
SHUTDOWN_COMPLETE=✅ Bot shutdown complete

# Starting messages
STARTING_BOT=🚀 Starting Stremio Discord Bot...
LOADING_CONFIG=📋 Loading configuration...
CONFIG_ERROR=❌ Config error: {error}
CREATING_BOT=🤖 Creating bot instance...
CONNECTING_DISCORD=🔌 Connecting to Discord...
INVALID_TOKEN=❌ Invalid BOT_TOKEN - check your .env file
INTERRUPTED=⚠️ Interrupted by user
FATAL_ERROR=❌ Fatal error: {error}
BOT_STOPPED=👋 Bot stopped by user
UNEXPECTED_ERROR=❌ Unexpected error: {error}

# Bot presence
BOT_PRESENCE=Stremio libraries | /help

# Error messages
ERROR_COMMAND_NOT_FOUND=❌ Unknown command. Use `!help` for a list of commands.
ERROR_MISSING_ARGUMENT=❌ Missing argument: `{param}`
    Use `!help` for more info.
ERROR_DM_ONLY=❌ This command only works in DMs
ERROR_NO_DM=❌ This command doesn't work in DMs
ERROR_COMMAND_FAILED=❌ An error occurred while executing this command.

# Help command
HELP_TITLE=📋 Stremio Bot Commands
HELP_DESCRIPTION=All commands are slash commands. Start typing `/` to see available commands!
HELP_SEARCH_TITLE=🎬 Search & Recommendations
HELP_SEARCH_VALUE=`/film <query>` - Search for movie recommendations using AI
    Example: `/film query: sci-fi like Inception`

    `/serie <query>` - Search for series recommendations using AI
    Example: `/serie query: mystery like True Detective`
HELP_LIBRARY_TITLE=📚 Library
HELP_LIBRARY_VALUE=`/library` - View your library (grid with posters)
    `/library filter: All (List)` - Show all items in table format
    `/library filter: Movies Only` - Show only movies in table
    `/library filter: Series Only` - Show only series in table

    💡 Click on items to share or remove them
HELP_WATCHED_TITLE=📜 Watched/Removed Items
HELP_WATCHED_VALUE=`/watched` - View all watched/removed items
    `/watched filter_type: Movies Only` - Show only watched movies
    `/watched filter_type: Series Only` - Show only watched series
    `/watched use_advanced: True` - Open modal for date range filtering

    📅 Advanced filtering lets you filter by date range!
HELP_AUTH_TITLE=🔐 Authentication
HELP_AUTH_VALUE=`/setauth <auth_key>` - Set your Stremio auth key (DM only)
    `/removeauth` - Remove your auth key (DM only)
    `/checkauth` - Check if auth key is set (DM only)

    ⚠️ **First time?** Send me a DM and use:
    `/setauth auth_key: <your_key>`
HELP_SYSTEM_TITLE=🔧 System
HELP_SYSTEM_VALUE=`/status` - Check Docker container status
HELP_ADMIN_TITLE=👑 Admin Commands
HELP_ADMIN_VALUE=`/ping` - Test bot responsiveness (admin only)
    `/restart <container_name>` - Restart a container (admin only)
    `/whoami` - Show your user ID and admin status
HELP_FOOTER=💡 Tip: All commands use Discord's slash command system. Type / to see all available commands!

